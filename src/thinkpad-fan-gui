class FanGUI:
    def __init__(self, root):
        self.root = root
        self.cfg = load_config()
        root.title("ThinkPad Fan Control")
        root.resizable(False, False)

        pad = {"padx": 10, "pady": 6}
        main = ttk.Frame(root, padding=12)
        main.grid(sticky="nsew")
        # Two side-by-side columns keep the window short enough for a laptop screen.
        leftcol = ttk.Frame(main)
        leftcol.grid(row=0, column=0, sticky="n")
        rightcol = ttk.Frame(main)
        rightcol.grid(row=0, column=1, sticky="n")

        # --- live status -----------------------------------------------------
        status = ttk.LabelFrame(leftcol, text="Status", padding=10)
        status.grid(row=0, column=0, sticky="ew", **pad)

        self.temp_var = tk.StringVar(value="--")
        self.gpu_temp_var = tk.StringVar(value="--")
        self.rpm_var = tk.StringVar(value="--")
        self.level_var = tk.StringVar(value="--")
        self.driver_var = tk.StringVar(value="--")
        self.daemon_var = tk.StringVar(value="checking…")

        ttk.Label(status, text="CPU temperature:").grid(row=0, column=0, sticky="w")
        ttk.Label(status, textvariable=self.temp_var, font=("", 14, "bold")).grid(row=0, column=1, sticky="w", padx=8)
        ttk.Label(status, text="GPU temperature:").grid(row=1, column=0, sticky="w")
        ttk.Label(status, textvariable=self.gpu_temp_var, font=("", 14, "bold")).grid(row=1, column=1, sticky="w", padx=8)
        ttk.Label(status, text="Fan speed:").grid(row=2, column=0, sticky="w")
        ttk.Label(status, textvariable=self.rpm_var).grid(row=2, column=1, sticky="w", padx=8)
        ttk.Label(status, text="Firmware level:").grid(row=3, column=0, sticky="w")
        ttk.Label(status, textvariable=self.level_var).grid(row=3, column=1, sticky="w", padx=8)
        ttk.Label(status, text="Level requested by:").grid(row=4, column=0, sticky="w")
        ttk.Label(status, textvariable=self.driver_var).grid(row=4, column=1, sticky="w", padx=8)
        ttk.Label(status, text="Daemon:").grid(row=5, column=0, sticky="w")
        ttk.Label(status, textvariable=self.daemon_var).grid(row=5, column=1, sticky="w", padx=8)

        # --- mode ------------------------------------------------------------
        modef = ttk.LabelFrame(leftcol, text="Mode", padding=10)
        modef.grid(row=1, column=0, sticky="ew", **pad)
        self.mode_var = tk.StringVar(value=self.cfg.get("mode", "auto"))
        for i, (val, label) in enumerate([
            ("auto", "Automatic (temperature curve)"),
            ("manual", "Manual (fixed level)"),
            ("bios", "BIOS / firmware default"),
        ]):
            ttk.Radiobutton(modef, text=label, value=val, variable=self.mode_var,
                            command=self._on_mode_change).grid(row=i, column=0, sticky="w")

        # --- manual ----------------------------------------------------------
        self.manualf = ttk.LabelFrame(leftcol, text="Manual level", padding=10)
        self.manualf.grid(row=2, column=0, sticky="ew", **pad)
        ml = self.cfg.get("manual_level", "auto")
        init = int(ml) if ml.isdigit() else 0
        # Single source of truth for the chosen manual level ("0".."7" / special).
        self.manual_choice = ml if ml in (
            "0", "1", "2", "3", "4", "5", "6", "7", "full-speed", "disengaged") else str(init)
        self.scale_label = ttk.Label(self.manualf, text="")
        self.scale_label.grid(row=0, column=0, columnspan=3, sticky="w")
        self.scale = ttk.Scale(self.manualf, from_=0, to=7, orient="horizontal", length=240,
                               command=self._on_scale)
        self.scale.set(init)
        self.scale.grid(row=1, column=0, columnspan=3, sticky="ew", pady=4)
        ttk.Label(self.manualf, text="0 = off / silent   ·   7 = maximum").grid(
            row=2, column=0, columnspan=3, sticky="w")
        ttk.Button(self.manualf, text="Full speed", command=lambda: self._set_special("full-speed")
                   ).grid(row=3, column=0, sticky="w", pady=(6, 0))
        ttk.Button(self.manualf, text="Disengaged (burst)", command=self._disengaged_warn
                   ).grid(row=3, column=1, sticky="w", pady=(6, 0), padx=6)
        self._update_manual_label()

        # --- auto curves (one tab per temperature source) ---------------------
        # The daemon runs BOTH curves and applies whichever asks for more
        # cooling, so each source can be tuned independently.
        self.autof = ttk.LabelFrame(rightcol, text="Automatic curve", padding=10)
        self.autof.grid(row=0, column=0, sticky="ew", **pad)
        # Called by the graph (no argument) and by the preset buttons (with
        # their own message).
        def edited(msg="Curve edited — press Apply."):
            self.msg_var.set(msg)

        self.tabs = ttk.Notebook(self.autof)
        self.tabs.grid(row=0, column=0, sticky="ew")

        self.cpu_editor = CurveEditor(self.tabs, self._curve_to_temps(self.cfg.get("curve")),
                                      PRESETS, edited)
        self.tabs.add(self.cpu_editor, text="  CPU  ")
        ttk.Label(self.cpu_editor.extra, text="Force full-speed at (°C):").grid(
            row=0, column=0, sticky="w")
        self.crit_var = tk.IntVar(value=self.cfg.get("critical_temp", 87))
        ttk.Spinbox(self.cpu_editor.extra, from_=60, to=90, width=4,
                    textvariable=self.crit_var).grid(row=0, column=1, padx=6)

        self.gpu_editor = CurveEditor(
            self.tabs, self._curve_to_temps(self.cfg.get("gpu_curve"), GPU_PRESETS),
            GPU_PRESETS, edited)
        self.tabs.add(self.gpu_editor, text="  GPU (NVIDIA)  ")
        self.gpu_enabled_var = tk.BooleanVar(
            value=self.cfg.get("gpu_monitoring", "auto") != "off")
        ttk.Checkbutton(self.gpu_editor.extra, text="Include NVIDIA GPU temperature",
                        variable=self.gpu_enabled_var).grid(
            row=0, column=0, columnspan=2, sticky="w")
        ttk.Label(self.gpu_editor.extra, text="Force full-speed at (°C):").grid(
            row=1, column=0, sticky="w", pady=(4, 0))
        self.gpu_crit_var = tk.IntVar(value=self.cfg.get("gpu_critical_temp", 90))
        ttk.Spinbox(self.gpu_editor.extra, from_=60, to=95, width=4,
                    textvariable=self.gpu_crit_var).grid(row=1, column=1, padx=6, pady=(4, 0))
        self.gpu_state_var = tk.StringVar(value="")
        ttk.Label(self.gpu_editor.extra, textvariable=self.gpu_state_var,
                  foreground="#666").grid(row=2, column=0, columnspan=2, sticky="w")

        # Shared across both sources.
        smoothf = ttk.Frame(self.autof)
        smoothf.grid(row=1, column=0, sticky="w", pady=(8, 0))
        ttk.Label(smoothf, text="Smooth temperature over (s):").grid(row=0, column=0, sticky="w")
        self.smooth_var = tk.IntVar(value=self.cfg.get("smoothing_seconds", 12))
        ttk.Spinbox(smoothf, from_=0, to=60, width=4, textvariable=self.smooth_var).grid(
            row=0, column=1, padx=6)
        ttk.Label(smoothf, text="(higher = steadier fan, ignores brief spikes)",
                  foreground="#666").grid(row=1, column=0, columnspan=2, sticky="w")

        # --- settings --------------------------------------------------------
        setf = ttk.LabelFrame(rightcol, text="Settings", padding=10)
        setf.grid(row=1, column=0, sticky="ew", **pad)
        self.autostart_var = tk.BooleanVar(value=autostart_enabled())
        ttk.Checkbutton(setf, text="Launch this control panel at login",
                        variable=self.autostart_var,
                        command=self._toggle_autostart).grid(row=0, column=0, sticky="w")
        ttk.Label(setf, text="(the background fan service already starts on boot)",
                  foreground="#666").grid(row=1, column=0, sticky="w")
        self.rekick_var = tk.BooleanVar(value=self.cfg.get("rekick_seconds", 5) > 0)
        ttk.Checkbutton(setf, text="Keep low levels spinning (pulse a stalled fan)",
                        variable=self.rekick_var).grid(row=2, column=0, sticky="w", pady=(6, 0))
        ttk.Label(setf, text="(levels 1–3 can't self-sustain; this re-kicks them for airflow)",
                  foreground="#666").grid(row=3, column=0, sticky="w")

        # --- actions (span both columns at the bottom) -----------------------
        actf = ttk.Frame(main)
        actf.grid(row=1, column=0, columnspan=2, sticky="ew", **pad)
        ttk.Button(actf, text="Apply", command=self.apply).grid(row=0, column=0, padx=4)
        ttk.Button(actf, text="Reload", command=self.reload).grid(row=0, column=1, padx=4)
        ttk.Button(actf, text="Quit", command=root.destroy).grid(row=0, column=2, padx=4)
        self.msg_var = tk.StringVar(value="")
        ttk.Label(main, textvariable=self.msg_var, foreground="#070").grid(
            row=2, column=0, columnspan=2, sticky="w", padx=10)

        self._on_mode_change()
        self._refresh()

    def _toggle_autostart(self):
        try:
            set_autostart(self.autostart_var.get())
            self.msg_var.set("Launch-at-login %s."
                             % ("enabled" if self.autostart_var.get() else "disabled"))
        except OSError as e:
            messagebox.showerror("Startup", f"Could not update autostart:\n{e}")
            self.autostart_var.set(autostart_enabled())

    # ----- helpers -------------------------------------------------------- #
    def _curve_to_temps(self, curve, presets=PRESETS):
        """Convert stored curve [[t,lv]...] to per-level temps for levels 1..7."""
        defaults = presets["Balanced"]
        temps = dict()
        if isinstance(curve, list):
            for item in curve:
                try:
                    t, lv = int(item[0]), int(item[1])
                    if 1 <= lv <= 7:
                        temps[lv] = t
                except (TypeError, ValueError, IndexError):
                    pass
        return [temps.get(lv, defaults[lv - 1]) for lv in range(1, 8)]

    def _on_mode_change(self):
        mode = self.mode_var.get()
        manual_state = "normal" if mode == "manual" else "disabled"
        auto_state = "normal" if mode == "auto" else "disabled"
        self._set_children_state(self.manualf, manual_state)
        self._set_children_state(self.autof, auto_state)
        self.cpu_editor.set_enabled(mode == "auto")
        self.gpu_editor.set_enabled(mode == "auto")

    def _set_children_state(self, frame, state):
        for child in frame.winfo_children():
            self._set_state_recursive(child, state)

    def _set_state_recursive(self, widget, state):
        try:
            widget.configure(state=state)
        except tk.TclError:
            pass
        for c in widget.winfo_children():
            self._set_state_recursive(c, state)

    def _update_manual_label(self):
        self.scale_label.config(text=f"Selected: level {self.manual_choice}")

    def _on_scale(self, _val):
        lv = int(round(float(self.scale.get())))
        self.manual_choice = str(lv)        # dragging the slider overrides any special level
        self._update_manual_label()

    def _set_special(self, value):
        self.manual_choice = value
        self._update_manual_label()

    def _disengaged_warn(self):
        if messagebox.askyesno(
                "Disengaged mode",
                "'Disengaged' removes the fan's speed limit for maximum airflow.\n\n"
                "It is meant for short bursts, not sustained use. Continue?"):
            self._set_special("disengaged")

    # ----- actions -------------------------------------------------------- #
    def _build_config(self):
        cfg = dict(self.cfg)
        cfg["mode"] = self.mode_var.get()
        if cfg["mode"] == "manual":
            cfg["manual_level"] = self.manual_choice

        cfg["curve"] = self._temps_to_curve(self.cpu_editor.temps())
        cfg["gpu_curve"] = self._temps_to_curve(self.gpu_editor.temps())
        cfg["critical_temp"] = int(self.crit_var.get())
        cfg["gpu_critical_temp"] = int(self.gpu_crit_var.get())
        cfg["gpu_monitoring"] = "auto" if self.gpu_enabled_var.get() else "off"
        cfg["smoothing_seconds"] = int(self.smooth_var.get())
        cfg["rekick_seconds"] = 5 if self.rekick_var.get() else 0
        return cfg

    @staticmethod
    def _temps_to_curve(temps):
        temps = sorted(max(1, t) for t in temps)   # keep thresholds monotonic
        return [[0, 0]] + [[temps[lv - 1], lv] for lv in range(1, 8)]

    def apply(self):
        cfg = self._build_config()
        try:
            save_config(cfg)
        except OSError as e:
            messagebox.showerror(
                "Cannot save",
                f"Could not write {CONFIG_PATH}:\n{e}\n\n"
                "Re-run the installer so the config is owned by your user.")
            return
        self.cfg = cfg
        self.msg_var.set("Applied. The daemon will pick it up within a couple of seconds.")

    def reload(self):
        self.cfg = load_config()
        self.mode_var.set(self.cfg.get("mode", "auto"))
        ml = self.cfg.get("manual_level", "0")
        self.manual_choice = ml
        if ml.isdigit():
            self.scale.set(int(ml))
        self._update_manual_label()
        self.cpu_editor.set_temps(self._curve_to_temps(self.cfg.get("curve")))
        self.gpu_editor.set_temps(
            self._curve_to_temps(self.cfg.get("gpu_curve"), GPU_PRESETS))
        self.crit_var.set(self.cfg.get("critical_temp", 87))
        self.gpu_crit_var.set(self.cfg.get("gpu_critical_temp", 90))
        self.gpu_enabled_var.set(self.cfg.get("gpu_monitoring", "auto") != "off")
        self.smooth_var.set(self.cfg.get("smoothing_seconds", 12))
        self.rekick_var.set(self.cfg.get("rekick_seconds", 5) > 0)
        self._on_mode_change()
        self.msg_var.set("Reloaded from disk.")

    # ----- live refresh --------------------------------------------------- #
    GPU_STATE_TEXT = {
        "off": "GPU monitoring is switched off.",
        "absent": "No NVIDIA GPU detected — this curve is unused.",
        "asleep": "NVIDIA GPU is powered down (hybrid graphics) — left alone.",
        "unavailable": "NVIDIA GPU temperature is currently unavailable.",
        "ok": None,      # replaced with the backend name below
    }

    def _refresh(self):
        # The daemon publishes what it actually decided; prefer that so the panel
        # can never disagree with the fan. Fall back to reading sensors here.
        st = read_status()
        speed, level = read_fan_proc()
        running = service_active()

        t = st.get("cpu_temp") if st else read_cpu_temp()
        self.temp_var.set(f"{t} °C" if t is not None else "n/a")

        gpu_t = st.get("gpu_temp") if st else read_gpu_temp()
        self.gpu_temp_var.set(f"{gpu_t} °C" if gpu_t is not None else "n/a")

        rpms = (st.get("fan_rpm") if st else None) or read_fan_rpms()
        if rpms:
            self.rpm_var.set("  ·  ".join(f"fan{i}: {r} RPM"
                                          for i, r in enumerate(rpms, 1)))
        else:
            self.rpm_var.set(f"{speed} RPM" if speed is not None else "n/a")

        self.level_var.set(level if level is not None else "n/a")

        if st:
            self.driver_var.set(self._driver_text(st))
            state = st.get("gpu_state")
            backend = st.get("gpu_backend")
            text = self.GPU_STATE_TEXT.get(state, "")
            if state == "ok":
                text = f"Reading GPU temperature via {backend}."
            self.gpu_state_var.set(text or "")
        else:
            # No snapshot: either the daemon is stopped, or it predates the
            # status file. Either way these figures are read locally instead.
            self.driver_var.set("n/a (no daemon status)" if running
                                else "n/a (daemon not running)")
            self.gpu_state_var.set("")

        if running:
            self.daemon_var.set("● running")
        else:
            self.daemon_var.set("● not running (run the installer)")
        self.root.after(1500, self._refresh)

    @staticmethod
    def _driver_text(st):
        """Which sensor asked for the level the daemon selected."""
        source = st.get("source")
        if st.get("critical"):
            return f"{(source or '?').upper()} (critical override)"
        if source is None:
            return {"manual": "manual setting",
                    "bios": "firmware"}.get(st.get("mode"), "—")
        levels = {"cpu": st.get("cpu_level"), "gpu": st.get("gpu_level")}
        other = "gpu" if source == "cpu" else "cpu"
        if levels.get(other) is None:
            return f"{source.upper()} (level {levels.get(source)})"
        return (f"{source.upper()} (cpu {levels['cpu']} · gpu {levels['gpu']})")


def main():
    # className sets the WM_CLASS so the desktop/dock matches our launcher icon.
    root = tk.Tk(className="thinkpad-fan-control")
    icon_path = find_icon()
    if icon_path:
        try:
            img = tk.PhotoImage(file=icon_path)
            root.iconphoto(True, img)
            root._icon_ref = img        # keep a reference so it isn't garbage-collected
        except tk.TclError:
            pass
    FanGUI(root)
    root.mainloop()


if __name__ == "__main__":
    main()
