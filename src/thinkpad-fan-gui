#!/usr/bin/env python3
"""
thinkpad-fan-gui - desktop control panel for thinkpad-fand.

Runs as the normal user (no root). It:
  * shows live CPU and (optional) NVIDIA GPU temperature, every fan RPM the
    machine reports, the selected level and which sensor asked for it,
  * lets you pick a mode (Auto curve / Manual / BIOS) and a manual level,
  * edits the CPU and GPU temperature curves - one tab each - on an interactive
    graph (drag points; X = fan speed %, Y = temperature) plus presets / boxes,
  * toggles "launch at login" (XDG autostart),
  * writes the user-owned config that the root daemon watches.

All writes go to a plain JSON file; the daemon does the privileged work.
Live figures come from the daemon's status snapshot when it is running, so the
panel shows exactly what the daemon decided; otherwise the sensors are read
directly here as a fallback.
"""

import ctypes
import json
import os
import sys
import time
import glob
import tkinter as tk
from tkinter import ttk, messagebox

CONFIG_PATH = "/etc/thinkpad-fan/config.json"
STATUS_PATH = "/run/thinkpad-fan/status.json"
FAN_PROC = "/proc/acpi/ibm/fan"
SERVICE = "thinkpad-fand"

# A status snapshot older than this is treated as stale (daemon stopped/hung).
STATUS_MAX_AGE = 10

# Temperature range shown on the curve graph's Y axis.
TEMP_MIN, TEMP_MAX = 20, 95

# XDG autostart entry for the "Launch at login" setting.
AUTOSTART_DIR = os.path.expanduser("~/.config/autostart")
AUTOSTART_FILE = os.path.join(AUTOSTART_DIR, "thinkpad-fan-control.desktop")

# Window icon: prefer the installed locations, fall back to the source tree
# (src/thinkpad-fan-gui -> ../data/icon.png) when running uninstalled.
_HERE = os.path.dirname(os.path.abspath(__file__))
ICON_CANDIDATES = [
    "/usr/share/icons/hicolor/256x256/apps/thinkpad-fan-control.png",
    "/usr/share/pixmaps/thinkpad-fan-control.png",
    os.path.join(_HERE, "..", "data", "icon.png"),
    os.path.join(_HERE, "icon.png"),
]

DEFAULT_CONFIG = {
    "mode": "auto",
    "manual_level": "auto",
    "curve": [[0, 0], [50, 1], [57, 2], [63, 3], [69, 4], [75, 5], [80, 6], [84, 7]],
    "hysteresis": 4,
    "critical_temp": 87,
    "poll_interval": 2,
    "smoothing_seconds": 12,
    "rekick_seconds": 5,
    "gpu_monitoring": "auto",
    "gpu_curve": [[0, 0], [60, 1], [65, 2], [70, 3], [74, 4], [78, 5], [82, 6], [85, 7]],
    "gpu_critical_temp": 90,
}

# Auto-curve presets: temperature at which each of levels 1..7 engages.
PRESETS = {
    "Quiet":    [56, 63, 69, 74, 79, 83, 86],
    "Balanced": [50, 57, 63, 69, 75, 80, 84],
    "Cool":     [42, 48, 54, 60, 66, 72, 78],
}

# GPUs idle cooler and are specified to run hotter than CPUs, so they get their
# own presets rather than reusing the CPU ones.
GPU_PRESETS = {
    "Quiet":    [65, 70, 75, 79, 83, 86, 89],
    "Balanced": [60, 65, 70, 74, 78, 82, 85],
    "Cool":     [50, 55, 60, 65, 70, 75, 80],
}


# --------------------------------------------------------------------------- #
# Reading system state (no root needed)
# --------------------------------------------------------------------------- #
def _hwmon_named(target):
    out = []
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            with open(os.path.join(d, "name")) as f:
                if f.read().strip() == target:
                    out.append(d)
        except OSError:
            pass
    return out


def _max_temp(dirs):
    temps = []
    for d in dirs:
        for inp in glob.glob(os.path.join(d, "temp*_input")):
            try:
                with open(inp) as f:
                    c = int(f.read().strip()) / 1000.0
                if 0 < c < 150:
                    temps.append(c)
            except (OSError, ValueError):
                pass
    return max(temps) if temps else None


def read_cpu_temp():
    # Intel (coretemp), AMD (k10temp), then the ThinkPad EC sensor, then anything.
    for name in ("coretemp", "k10temp", "thinkpad"):
        t = _max_temp(_hwmon_named(name))
        if t is not None:
            return int(round(t))
    t = _max_temp(glob.glob("/sys/class/hwmon/hwmon*"))
    return int(round(t)) if t is not None else None


def read_gpu_temp():
    """Best-effort NVIDIA GPU temperature, used only when the daemon's status
    snapshot isn't available. The daemon has the authoritative reader; this is a
    trimmed version of it (NVML, then a GPU hwmon, then the ThinkPad EC sensor)
    with no subprocess fallback - the panel is not safety-critical."""
    try:
        for d in glob.glob("/sys/bus/pci/devices/*"):
            with open(os.path.join(d, "vendor")) as f:
                if f.read().strip().lower() != "0x10de":
                    continue
            with open(os.path.join(d, "class")) as f:
                if not f.read().strip().lower().startswith("0x03"):
                    continue
            try:
                with open(os.path.join(d, "power", "runtime_status")) as f:
                    if f.read().strip() == "suspended":
                        continue          # powered down: don't wake it just to look
            except OSError:
                pass
            t = _read_nvml_temp()
            if t is not None:
                return int(round(t))
            break
    except OSError:
        pass
    t = _max_temp(_hwmon_named("nvidia") + _hwmon_named("nouveau"))
    if t is not None:
        return int(round(t))
    t = _thinkpad_ec_gpu_temp()
    return int(round(t)) if t is not None else None


def _read_nvml_temp():
    """GPU temperature via the driver's own NVML library (no extra dependency).
    Opened and closed around the read so a hybrid-graphics dGPU is never pinned
    awake by this panel."""
    try:
        lib = ctypes.CDLL("libnvidia-ml.so.1")
        if lib.nvmlInit_v2() != 0:
            return None
        try:
            handle = ctypes.c_void_p()
            if lib.nvmlDeviceGetHandleByIndex_v2(0, ctypes.byref(handle)) != 0:
                return None
            value = ctypes.c_uint(0)
            if lib.nvmlDeviceGetTemperature(handle, 0, ctypes.byref(value)) != 0:
                return None
            return float(value.value)
        finally:
            lib.nvmlShutdown()
    except Exception:
        return None


def _thinkpad_ec_gpu_temp():
    """The ThinkPad EC's 'GPU'-labelled sensor, where the model reports one."""
    for d in _hwmon_named("thinkpad"):
        for label_path in sorted(glob.glob(os.path.join(d, "temp*_label"))):
            try:
                with open(label_path) as f:
                    if f.read().strip().upper() != "GPU":
                        continue
                with open(label_path.replace("_label", "_input")) as f:
                    c = int(f.read().strip()) / 1000.0
            except (OSError, ValueError):
                continue
            if 0 < c < 150:
                return c
    return None


def read_fan_rpms():
    """Every fan RPM the ThinkPad exposes. P1/P50-class models have two fans
    with separate tachometers but one shared EC level, so both are shown while
    control stays on the single /proc/acpi/ibm/fan level."""
    for d in _hwmon_named("thinkpad"):
        rpms = []
        for inp in sorted(glob.glob(os.path.join(d, "fan*_input"))):
            try:
                with open(inp) as f:
                    rpms.append(int(f.read().strip()))
            except (OSError, ValueError):
                pass
        if rpms:
            return rpms
    return []


def read_status():
    """The daemon's latest snapshot, or None if it isn't running / is stale."""
    try:
        with open(STATUS_PATH) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    if time.time() - data.get("updated", 0) > STATUS_MAX_AGE:
        return None
    return data


def read_fan_proc():
    """Return (speed_rpm, level_str) from /proc/acpi/ibm/fan."""
    speed, level = None, None
    try:
        with open(FAN_PROC) as f:
            for line in f:
                if line.startswith("speed:"):
                    speed = line.split(":", 1)[1].strip()
                elif line.startswith("level:"):
                    level = line.split(":", 1)[1].strip()
    except OSError:
        pass
    return speed, level


def service_active():
    return os.system(f"systemctl is-active --quiet {SERVICE}") == 0


# --------------------------------------------------------------------------- #
# Config load/save
# --------------------------------------------------------------------------- #
def load_config():
    try:
        with open(CONFIG_PATH) as f:
            cfg = json.load(f)
        merged = dict(DEFAULT_CONFIG)
        merged.update(cfg)
        return merged
    except (OSError, ValueError):
        return dict(DEFAULT_CONFIG)


def save_config(cfg):
    """Atomic write via temp file + os.replace (needs a writable directory)."""
    d = os.path.dirname(CONFIG_PATH)
    tmp = os.path.join(d, ".config.json.tmp")
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, CONFIG_PATH)


# --------------------------------------------------------------------------- #
# Autostart ("Launch at login") + icon
# --------------------------------------------------------------------------- #
def autostart_enabled():
    return os.path.isfile(AUTOSTART_FILE)


def set_autostart(enabled):
    if enabled:
        # Prefer the canonical installed binary; fall back to however we were run.
        exec_path = "/usr/bin/thinkpad-fan-gui"
        if not os.path.isfile(exec_path):
            exec_path = os.path.abspath(sys.argv[0])
        os.makedirs(AUTOSTART_DIR, exist_ok=True)
        with open(AUTOSTART_FILE, "w") as f:
            f.write(
                "[Desktop Entry]\n"
                "Type=Application\n"
                "Name=ThinkPad Fan Control\n"
                f"Exec={exec_path}\n"
                "Icon=thinkpad-fan-control\n"
                "Terminal=false\n"
                "X-GNOME-Autostart-enabled=true\n"
            )
    else:
        try:
            os.remove(AUTOSTART_FILE)
        except FileNotFoundError:
            pass


def find_icon():
    for p in ICON_CANDIDATES:
        if os.path.isfile(p):
            return p
    return None


# --------------------------------------------------------------------------- #
# Editable fan-curve graph
# --------------------------------------------------------------------------- #
class CurveCanvas(tk.Canvas):
    """Drag points to shape the fan curve.

    X axis = fan speed % (levels 1..7 -> ~14%..100%), Y axis = temperature.
    Each point is the temperature at which that fan speed turns on. Points are
    kept monotonic (a higher speed can't engage at a lower temperature) and are
    bound to the same IntVars as the numeric spinboxes, so the two stay in sync.
    """
    W, H = 384, 226
    ML, MR, MT, MB = 46, 14, 16, 34          # margins (axis labels live here)

    def __init__(self, parent, level_temp_vars, on_change=None):
        super().__init__(parent, width=self.W, height=self.H, bg="white",
                         highlightthickness=1, highlightbackground="#bbb")
        self.vars = level_temp_vars          # 7 IntVars: temps for levels 1..7
        self.on_change = on_change
        self.active = None
        self.enabled = True
        self.bind("<Button-1>", self._press)
        self.bind("<B1-Motion>", self._drag)
        self.bind("<ButtonRelease-1>", self._release)
        self.redraw()

    def _pw(self):
        return self.W - self.ML - self.MR

    def _ph(self):
        return self.H - self.MT - self.MB

    def _x_for_level(self, lv):
        return self.ML + (lv / 7.0) * self._pw()

    def _y_for_temp(self, t):
        frac = max(0.0, min(1.0, (t - TEMP_MIN) / (TEMP_MAX - TEMP_MIN)))
        return self.MT + (1 - frac) * self._ph()

    def _temp_for_y(self, y):
        frac = 1 - (y - self.MT) / self._ph()
        t = TEMP_MIN + frac * (TEMP_MAX - TEMP_MIN)
        return int(round(max(TEMP_MIN, min(TEMP_MAX, t))))

    def set_enabled(self, enabled):
        self.enabled = enabled
        self.redraw()

    def redraw(self):
        self.delete("all")
        x0, y0 = self.ML, self.MT
        x1, y1 = self.W - self.MR, self.H - self.MB
        accent = "#2563eb" if self.enabled else "#b9b9b9"
        txt = "#333" if self.enabled else "#aaa"

        # gridlines + Y (temperature) labels
        for t in range(TEMP_MIN, TEMP_MAX + 1, 15):
            yy = self._y_for_temp(t)
            self.create_line(x0, yy, x1, yy, fill="#eee")
            self.create_text(x0 - 6, yy, text=str(t), anchor="e", font=("", 7), fill="#777")
        # axes
        self.create_line(x0, y0, x0, y1, fill="#999")
        self.create_line(x0, y1, x1, y1, fill="#999")
        # X (fan %) labels
        for lv in range(1, 8):
            xx = self._x_for_level(lv)
            self.create_text(xx, y1 + 9, text=str(int(round(lv / 7 * 100))),
                             anchor="n", font=("", 7), fill="#777")
        self.create_text((x0 + x1) // 2, self.H - 3, text="Fan speed %",
                         anchor="s", font=("", 8), fill="#555")
        self.create_text(11, (y0 + y1) // 2, text="°C",
                         anchor="center", font=("", 8), fill="#555")

        # curve line + points
        pts = [(self._x_for_level(lv), self._y_for_temp(self.vars[lv - 1].get()))
               for lv in range(1, 8)]
        flat = [c for xy in pts for c in xy]
        self.create_line(*flat, fill=accent, width=2)
        for i, (x, y) in enumerate(pts):
            self.create_oval(x - 6, y - 6, x + 6, y + 6, fill=accent,
                             outline="white", width=2)
            self.create_text(x, y - 13, text=str(self.vars[i].get()),
                             font=("", 7, "bold"), fill=txt)

    def _nearest(self, x):
        best, best_d = None, 1e9
        for lv in range(1, 8):
            d = abs(self._x_for_level(lv) - x)
            if d < best_d:
                best_d, best = d, lv - 1
        return best if best_d < 28 else None

    def _press(self, e):
        if self.enabled:
            self.active = self._nearest(e.x)

    def _drag(self, e):
        if not self.enabled or self.active is None:
            return
        i = self.active
        t = self._temp_for_y(e.y)
        # Keep the curve monotonic: clamp between the neighbouring points.
        lo = self.vars[i - 1].get() + 1 if i > 0 else TEMP_MIN
        hi = self.vars[i + 1].get() - 1 if i < 6 else TEMP_MAX
        t = max(lo, min(max(lo, hi), t))
        self.vars[i].set(t)
        self.redraw()
        if self.on_change:
            self.on_change()

    def _release(self, _e):
        self.active = None


class CurveEditor(ttk.Frame):
    """Presets + draggable graph + numeric boxes for ONE temperature source.

    Instantiated once per source (CPU, GPU) so each gets an independent curve;
    the daemon runs both and obeys whichever asks for the most cooling.
    """

    def __init__(self, parent, temps, presets, on_change):
        super().__init__(parent, padding=10)
        self.presets = presets
        self.on_change = on_change
        self.vars = [tk.IntVar(value=t) for t in temps]

        presetf = ttk.Frame(self)
        presetf.grid(row=0, column=0, columnspan=2, sticky="w")
        ttk.Label(presetf, text="Preset:").grid(row=0, column=0, sticky="w")
        for i, name in enumerate(presets):
            ttk.Button(presetf, text=name, width=9,
                       command=lambda n=name: self.apply_preset(n)).grid(
                row=0, column=i + 1, padx=3)

        ttk.Label(self, text="Drag a point to set the temperature at which "
                             "each fan speed turns on:").grid(
            row=1, column=0, columnspan=2, sticky="w", pady=(8, 4))

        self.canvas = CurveCanvas(self, self.vars, on_change=on_change)
        self.canvas.grid(row=2, column=0, columnspan=2, pady=(0, 6))

        grid = ttk.Frame(self)
        grid.grid(row=3, column=0, columnspan=2, sticky="w")
        for lv in range(1, 8):
            col = (lv - 1) % 4
            r = 2 * ((lv - 1) // 4)
            ttk.Label(grid, text=f"{int(round(lv / 7 * 100))}%").grid(row=r, column=col, padx=4)
            ttk.Spinbox(grid, from_=TEMP_MIN, to=TEMP_MAX, width=4,
                        textvariable=self.vars[lv - 1]).grid(
                row=r + 1, column=col, padx=4, pady=(0, 6))
        for var in self.vars:
            var.trace_add("write", lambda *_a: self.canvas.redraw())

        # Rows 4+ are left free for the caller to add per-source extras
        # (the critical-temperature box, the GPU monitoring toggle).
        self.extra = ttk.Frame(self)
        self.extra.grid(row=4, column=0, columnspan=2, sticky="w", pady=(4, 0))

    def apply_preset(self, name):
        for var, t in zip(self.vars, self.presets[name]):
            var.set(t)
        if self.on_change:
            self.on_change(f"Loaded '{name}' preset — press Apply.")

    def set_temps(self, temps):
        for var, t in zip(self.vars, temps):
            var.set(t)

    def temps(self):
        return [v.get() for v in self.vars]

    def set_enabled(self, enabled):
        self.canvas.set_enabled(enabled)


